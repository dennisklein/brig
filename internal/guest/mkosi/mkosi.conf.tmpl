#
# brig base image: headless Fedora running an OpenShell gateway as user agent.
# Generated by brig; see mkosi(1).

[Config]
MinimumVersion=26

[Distribution]
Distribution=fedora
Release={{.FedoraRelease}}
Architecture=x86-64

[Output]
# A GPT disk image base.raw: ESP plus an ext4 root, see mkosi.repart/.
Format=disk
Output=base
CompressOutput=no
ManifestFormat=json

[Build]
# Unprivileged builds map every file to root; let useradd in
# mkosi.postinst.chroot succeed although it cannot chown its mail spool.
Environment=MKOSI_CHROOT_SUPPRESS_CHOWN=1

[Content]
Bootable=yes
# Unsigned UKIs: the VMs boot with UEFI Secure Boot disabled.
Bootloader=systemd-boot
# fsck.repair=yes: a data disk whose damage the default preen mode would
# leave to a root shell, which the locked root account refuses, is
# repaired, so the VM still boots.
KernelCommandLine=console=ttyS0 rw systemd.firstboot=no fsck.repair=yes
Locale=C.UTF-8
Keymap=us
Timezone=UTC
WithDocs=no
WithRecommends=no
# Fail the build on labelling errors instead of shipping a mislabelled image.
SELinuxRelabel=yes
# sshd listens on the network; no mkosi vsock units.
Ssh=no
# Weak dependencies are off, so everything the VM relies on is listed.
Packages=
        kernel
        systemd
        systemd-udev
        # Only recommended by systemd: pam_systemd registers SSH logins with
        # logind, which gives them XDG_RUNTIME_DIR for systemctl --user.
        systemd-pam
        # Only recommended by systemd-udev: systemd-vconsole-setup.service
        # runs loadkeys at every boot and fails without it.
        kbd
        systemd-boot-unsigned
        systemd-networkd
        systemd-resolved
        dbus-broker
        bash
        openssh-server
        shadow-utils
        e2fsprogs
        nftables
        iproute
        sqlite
        qemu-guest-agent
        dnf5
        selinux-policy-targeted
        policycoreutils
        container-selinux
        podman
        crun
        conmon
        netavark
        aardvark-dns
        passt
        catatonit
        openssl
{{- range .OpenShellPackages}}
        {{.}}
{{- end}}
