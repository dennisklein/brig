#
# User units of brig VMs, enabled for all users; the brig units and the
# OpenShell gateway drop-in limit themselves to agent with ConditionUser=.

enable podman.socket
enable openshell-gateway.service
enable brig-gateway-proxy.socket
enable brig-sandbox-volumes.service
