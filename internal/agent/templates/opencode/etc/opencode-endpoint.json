{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "model": "llm/{{.Model}}",
  "provider": {
    "llm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LLM endpoint",
      "options": {
        "baseURL": "{{.EndpointURL}}",
        "apiKey": "{env:LLM_API_KEY}"
      },
      "models": {
        "{{.Model}}": { "name": "{{.Model}}" }
      }
    }
  }
}
