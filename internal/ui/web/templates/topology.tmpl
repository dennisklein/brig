{{define "page-topology"}}
<div class="head"><div class="titles"><h1>Topology</h1><div class="sub">From this host to every endpoint a sandbox can reach, and those it tried and could not.</div></div>
  <div class="actions"><nav class="seg" aria-label="Filter by VM"><a class="{{if not .Filter}}on{{end}}" href="/topology">All VMs</a>{{range .Snap.VMs}}<a class="{{if eq .Name $.Filter}}on{{end}}" href="/topology?vm={{.Name}}">{{.Name}}</a>{{end}}</nav></div>
</div>
<div sse-swap="topology">{{template "topology" .}}</div>
{{end}}
