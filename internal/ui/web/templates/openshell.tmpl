{{/* OpenShell: sandboxes and gateways, read from each VM's gateway. */}}

{{define "phase"}}<span class="pill {{phaseClass .}}"><span class="dot"></span>{{.}}</span>{{end}}

{{define "gwstate"}}<span class="pill {{gatewayClass .}}"><span class="dot"></span>{{.}}</span>{{end}}

{{/* A note on a gateway whose parts are not live: stopped, unreachable,
     another OpenShell minor version. */}}
{{define "gwnote"}}{{$g := .}}
{{if eq $g.State "stopped"}}<div class="callout warn gap-below">{{$g.VM}} is not running.{{if $g.Answered}} This is what {{$g.Name}} held when it last answered, {{rel $g.Seen}}.{{end}} Start it with <code>brig start {{$g.VM}}</code>.</div>
{{else if eq $g.State "unreachable"}}<div class="callout bad gap-below"><b>brig ui cannot reach {{$g.Name}}.</b> {{$g.Err}}{{if $g.Answered}}<br>This is what it held {{rel $g.Seen}}.{{end}}</div>
{{else if eq $g.State "connecting"}}<div class="callout gap-below">Connecting to {{$g.Name}}…</div>{{end}}
{{if otherMinor $g}}<div class="callout warn gap-below">{{$g.Name}} runs OpenShell {{$g.Version}}; brig ui reads gateways as OpenShell {{stubsVersion}} does, so some details may be missing.</div>{{end}}
{{end}}

{{define "chips"}}{{range .}}<span class="chip">{{.}}</span> {{else}}<span class="faint">none</span>{{end}}{{end}}

{{/* Sandboxes. */}}

{{define "sandbox-table"}}
<table><thead><tr><th>Sandbox</th><th>VM</th><th>State</th><th>Image</th><th>Providers</th><th class="num">Policy</th></tr></thead><tbody>
{{range sandboxRows .Snap .Filter}}<tr class="click" data-href="/sandboxes/{{.VM}}/{{.Name}}">
  <td><a class="rowlink" href="/sandboxes/{{.VM}}/{{.Name}}">{{.Name}}</a></td>
  <td class="mono">{{.VM}}{{if ne .Gateway.State "ready"}} <span class="faint">{{.Gateway.State}}</span>{{end}}</td>
  <td>{{template "phase" .Phase}}</td>
  <td class="mono">{{.Image}}</td>
  <td>{{template "chips" .Providers}}</td>
  <td class="num mono">{{with .Policy}}{{if .Global}}global {{end}}v{{.Version}}{{else}}<span class="faint">–</span>{{end}}</td>
</tr>{{else}}<tr><td colspan="6" class="empty">{{if .Snap.Gateways}}No sandboxes{{with .Filter}} on {{.}}{{end}}. Create one with New sandbox.{{else}}No VMs with an OpenShell gateway yet.{{end}}</td></tr>{{end}}
</tbody></table>
{{end}}

{{/* A sandbox: the header, the tabs and the tab's body, replaced as a
     whole. */}}

{{define "sandbox"}}{{$g := .Gateway}}{{$s := .Sandbox}}{{if not $s.Name}}
<div class="crumbs"><a href="/sandboxes">Sandboxes</a></div>
<section class="panel empty">This sandbox is gone: it was deleted, or its VM no longer exists.</section>
{{else}}
<div class="crumbs"><a href="/sandboxes">Sandboxes</a><span>/</span><a href="/vms/{{$g.VM}}">{{$g.VM}}</a><span>/</span><span>{{$s.Name}}</span></div>
<div class="head"><div class="titles"><h1>{{$s.Name}}</h1>
  <div class="sub">{{template "phase" $s.Phase}}<span>on <a href="/gateways/{{$g.VM}}">{{$g.Name}}</a></span>{{with $s.Image}}<span class="mono">{{.}}</span>{{end}}{{if not $s.Created.IsZero}}<span>created {{rel $s.Created}}</span>{{end}}</div></div>
  <div class="actions">
    <button type="button" class="btn{{if $s.Ready}} primary{{end}}" hx-get="/terminal?vm={{$g.VM}}&amp;sandbox={{$s.Name}}" hx-target="#layer" hx-swap="innerHTML">Connect…</button>
    {{if or (eq $s.Phase "Stopped") (eq $s.Phase "Error")}}{{template "act" (act $ "sandbox-start" "" "primary" "vm" $g.VM "sandbox" $s.Name)}}{{else if ne $s.Phase "Deleting"}}{{template "act" (act $ "sandbox-stop" "" "" "vm" $g.VM "sandbox" $s.Name)}}{{end}}
    {{template "act" (act $ "sandbox-delete" "" "danger" "vm" $g.VM "sandbox" $s.Name)}}
  </div>
</div>
{{template "gwnote" $g}}
{{with $s.Problem}}<div class="callout bad gap-below">{{.}}</div>{{end}}
<div class="tabs">{{range sandboxTabs}}<a class="tab{{if eq .Key $.Tab}} on{{end}}" href="/sandboxes/{{$g.VM}}/{{$s.Name}}?tab={{.Key}}">{{.Label}}</a>{{end}}</div>
{{if eq .Tab "overview"}}{{template "sandbox-overview" .}}
{{else if eq .Tab "policy"}}{{template "sandbox-policy" .}}
{{else if eq .Tab "files"}}{{template "sandbox-files" .}}{{end}}
{{end}}{{end}}

{{define "sandbox-overview"}}{{$g := .Gateway}}{{$s := .Sandbox}}
<div class="grid g2">
  <section class="panel"><div class="ph"><h2>Providers</h2><span class="faint small">The agent sees placeholders.</span><span class="grow"></span>{{template "act" (act $ "sandbox-attach" "" "sm" "vm" $g.VM "sandbox" $s.Name)}}</div>
  <div class="tw"><table><tbody>
  {{range $s.Providers}}{{$p := providerOf $g .}}<tr><td class="strong">{{.}}</td>
    <td class="mono small">{{with $p}}{{range .Credentials}}{{.}}<br>{{end}}{{else}}<span class="faint">not on the gateway</span>{{end}}</td>
    <td class="muted small">{{with $p}}{{with profileOf $g .Type}}{{range $i, $e := .Endpoints}}{{if $i}}, {{end}}{{$e}}{{end}}{{end}}{{end}}</td>
    <td class="num">{{template "act" (act $ "sandbox-detach" "" "sm ghost" "vm" $g.VM "sandbox" $s.Name "provider" .)}}</td></tr>
  {{else}}<tr><td class="empty">No providers. This sandbox reaches only what its policy allows, without credentials.</td></tr>{{end}}
  </tbody></table></div></section>
  <section class="panel"><div class="ph"><h2>Setup</h2></div><div class="pb">
    <dl class="kv">
      <dt>Template</dt><dd class="mono">{{with $s.Template}}{{.}}{{else}}<span class="faint">none</span>{{end}}</dd>
      <dt>Image</dt><dd class="mono">{{$s.Image}}</dd>
      <dt>Policy</dt><dd>{{with $s.Policy}}{{if .Global}}the gateway's global policy, {{end}}version {{.Version}}{{if .ProviderRules}}, with {{len .ProviderRules}} provider rule{{if ne (len .ProviderRules) 1}}s{{end}}{{end}} · <a href="/sandboxes/{{$g.VM}}/{{$s.Name}}?tab=policy">show</a>{{else}}<span class="faint">not read yet</span>{{end}}</dd>
      <dt>Workspace</dt><dd class="mono">/sandbox <span class="faint">kept across stop and start</span></dd>
    </dl></div></section>
</div>
<section class="panel gap-above"><div class="ph"><h2>From your terminal</h2></div><div class="pb stack">
  {{template "cmd" (cmd (print "Connect to the sandbox" (or (and (not $s.Ready) ", once it runs") "")) (oscmd $g.VM "sandbox" "connect" $s.Name))}}
  {{template "cmd" (cmd "Everything the gateway knows about it" (oscmd $g.VM "sandbox" "get" $s.Name))}}
</div></section>
{{end}}

{{define "sandbox-policy"}}{{$g := .Gateway}}{{$s := .Sandbox}}{{$p := $s.Policy}}
{{if not $p}}<section class="panel empty">brig ui has not read this sandbox's policy yet.</section>
{{else if $p.Err}}<div class="callout bad">brig ui cannot show this sandbox's policy: {{$p.Err}}</div>
{{else}}
<div class="grid g2">
  <section class="panel"><div class="ph"><h2>Base</h2><span class="faint small">the policy the sandbox was created with, and rules added since</span></div><div class="pb stack">
    {{template "policy-code" (policyLines $p.Base nil nil)}}
    {{template "cmd" (cmd "" (oscmd $g.VM "policy" "get" $s.Name "--base"))}}
  </div></section>
  <section class="panel"><div class="ph"><h2>Effective</h2><span class="faint small">base and the rules of attached providers</span></div><div class="pb stack">
    {{template "policy-code" (policyLines $p.Effective $p.ProviderRules $s.Providers)}}
    {{template "cmd" (cmd "" (oscmd $g.VM "policy" "get" $s.Name "--full"))}}
  </div></section>
</div>
<p class="note">{{if $p.Global}}A global policy on {{$g.Name}} overrides this sandbox's own. {{end}}Network rules reload at once. Filesystem and process settings are fixed once the sandbox starts.</p>
{{template "cmd" (cmd "Rules of the base policy that are not in your policy files" (print "brig policy diff " $g.VM " " $s.Name))}}
{{end}}
{{end}}

{{define "policy-code"}}<pre class="code">{{range .}}{{if .Provider}}<span class="add">{{.Indent}}{{if .Key}}<span class="k">{{.Key}}</span>:{{.Rest}}{{else}}{{.Text}}{{end}}{{if .First}}<span class="c">   # from provider {{.Provider}}</span>{{end}}</span>{{else}}{{.Indent}}{{if .Key}}<span class="k">{{.Key}}</span>:{{.Rest}}{{else}}{{.Text}}{{end}}
{{end}}{{end}}</pre>{{end}}

{{define "sandbox-files"}}{{$g := .Gateway}}{{$s := .Sandbox}}
<section class="panel"><div class="ph"><h2 class="mono">/sandbox</h2><span class="faint small">The sandbox's workspace, kept across stop and start</span></div><div class="pb stack">
  {{template "cmd" (cmd "List it" (oscmd $g.VM "sandbox" "exec" "-n" $s.Name "--no-tty" "--" "ls" "-la" "/sandbox"))}}
  {{template "cmd" (cmd "Upload a file or directory (in a Git work tree, .gitignore applies)" (oscmd $g.VM "sandbox" "upload" $s.Name "PATH" "/sandbox/"))}}
  {{template "cmd" (cmd "Download a file or directory" (oscmd $g.VM "sandbox" "download" $s.Name "/sandbox/PATH" "."))}}
</div></section>
{{end}}

{{/* A gateway: its providers, profiles, policies and templates. */}}

{{define "gateway"}}{{$g := .Gateway}}{{if not $g.VM}}
<div class="head"><div class="titles"><h1>Gateway</h1></div></div>
<section class="panel empty">No VMs yet, so no OpenShell gateways. Create one in a terminal: <code>brig create NAME</code></section>
{{else}}
<div class="head"><div class="titles"><h1>OpenShell <span class="muted">· {{$g.Name}}</span></h1>
  <div class="sub">{{template "gwstate" $g.State}}{{with $g.Version}}<span>OpenShell {{.}}</span>{{end}}<span>workspace default</span>{{with $g.Config.Dirs}}<span>config from {{range $i, $d := .}}{{if $i}}, {{end}}<span class="mono">{{tilde $d}}</span>{{end}}</span>{{end}}</div></div>
  <div class="actions"><nav class="seg" aria-label="Gateway">{{range .Snap.Gateways}}<a class="{{if eq .VM $g.VM}}on{{end}}" href="/gateways/{{.VM}}?tab={{$.Tab}}">{{.Name}}</a>{{end}}</nav></div>
</div>
{{template "gwnote" $g}}
{{with $g.Config.Err}}<div class="callout bad gap-below">brig cannot read the config directories: {{.}}</div>{{end}}
<div class="tabs">{{range gatewayTabs}}<a class="tab{{if eq .Key $.Tab}} on{{end}}" href="/gateways/{{$g.VM}}?tab={{.Key}}">{{.Label}}{{if eq .Key "providers"}}<span class="n">{{len $g.Providers}}</span>{{else if eq .Key "profiles"}}<span class="n">{{len $g.Profiles}}</span>{{else if eq .Key "templates"}}<span class="n">{{len $g.Templates}}</span>{{end}}</a>{{end}}</div>
{{if eq .Tab "providers"}}{{template "gateway-providers" .}}
{{else if eq .Tab "profiles"}}{{template "gateway-profiles" .}}
{{else if eq .Tab "policies"}}{{template "gateway-policies" .}}
{{else if eq .Tab "templates"}}{{template "gateway-templates" .}}{{end}}
{{end}}{{end}}

{{define "gateway-providers"}}{{$g := .Gateway}}{{$v := .VM}}
<section class="panel tw"><table><thead><tr><th>Provider</th><th>Profile</th><th>Credentials</th><th>Source</th><th>Attached to</th></tr></thead><tbody>
{{range providerRows $g}}<tr>
  <td class="strong">{{.Name}}</td>
  <td class="mono">{{with .Type}}{{.}}{{else}}<span class="faint">–</span>{{end}}</td>
  <td class="mono small">{{range .Credentials}}{{.}} <span class="faint">in the gateway</span><br>{{else}}<span class="faint">–</span>{{end}}</td>
  <td class="mono small">{{with .Source}}{{tilde .}}{{else}}<span class="faint">by hand</span>{{end}}</td>
  <td>{{if .Missing}}<span class="pill bad">not on the gateway</span>{{else}}{{range $i, $s := .Sandboxes}}{{if $i}}, {{end}}<a href="/sandboxes/{{$g.VM}}/{{$s}}">{{$s}}</a>{{else}}<span class="faint">–</span>{{end}}{{end}}</td>
</tr>{{else}}<tr><td colspan="5" class="empty">No providers on this gateway.</td></tr>{{end}}
</tbody></table></section>
{{with $v.LastSync}}{{if .Error}}<div class="callout bad gap-above"><b>The last sync, {{rel .Time}}, failed.</b><br>{{.Error}}</div>{{else}}<p class="note">Last sync of the config directories {{rel .Time}}.</p>{{end}}{{end}}
<p class="note">brig ui never shows or takes secrets. brig sync sends them from your keyring to the gateway; to rotate one, store the new value with secret-tool and sync.</p>
<div class="stack gap-above">
{{if $g.Config.Dirs}}{{template "cmd" (cmd "Preview what a sync would change" (print "brig sync " $g.VM " --dry-run"))}}{{end}}
{{template "cmd" (cmd "The same list from your terminal" (oscmd $g.VM "provider" "list"))}}
</div>
{{end}}

{{define "gateway-profiles"}}{{$g := .Gateway}}
<div class="grid g2">
{{range profileRows $g}}<section class="panel"><div class="ph"><h2>{{.ID}}</h2>{{with .Category}}<span class="chip">{{.}}</span>{{end}}{{with .Scope}}<span class="chip">{{.}}</span>{{end}}<span class="grow"></span><span class="faint mono small">{{with .File}}{{tilde .}}{{else}}{{.Source}}{{end}}</span></div><div class="pb">
  {{with .Description}}<p class="muted small">{{.}}</p>{{end}}
  <dl class="kv">
    <dt>Credentials</dt><dd class="mono small">{{range .Credentials}}{{range $i, $e := .EnvVars}}{{if $i}}, {{end}}{{$e}}{{end}}{{with .Auth}} <span class="faint">as {{.}}</span>{{end}}<br>{{else}}<span class="faint">none</span>{{end}}</dd>
    <dt>Endpoints</dt><dd class="mono small">{{range .Endpoints}}{{.}}<br>{{else}}<span class="faint">none</span>{{end}}</dd>
    <dt>Binaries</dt><dd class="mono small">{{range .Binaries}}{{.}}<br>{{else}}<span class="faint">any</span>{{end}}</dd>
    <dt>Providers</dt><dd>{{template "chips" .Providers}}</dd>
  </dl></div></section>
{{else}}<section class="panel empty">No provider profiles.</section>{{end}}
</div>
<div class="stack gap-above">{{template "cmd" (cmd "The same list from your terminal" (oscmd $g.VM "profile" "list"))}}</div>
{{end}}

{{define "gateway-policies"}}{{$g := .Gateway}}{{$c := $g.Config}}
<section class="panel"><div class="ph"><h2>Default sandbox policy</h2><span class="faint mono small">{{with $c.DefaultPolicy}}{{tilde .}}{{end}}</span>{{if $c.DefaultPolicy}}<span class="grow"></span><span class="chip acc">OPENSHELL_SANDBOX_POLICY</span>{{end}}</div><div class="pb">
{{if $c.DefaultPolicy}}{{template "policy-code" (policyLines $c.DefaultPolicyText nil nil)}}
<p class="note">brig use {{$g.VM}} and brig sandbox create export it, so that openshell sandbox create picks it up.</p>
{{else}}<p class="muted">{{if $c.Dirs}}The config directories have no policies/default.yaml.{{else}}{{$g.VM}} has no OpenShell config directories.{{end}} New sandboxes get the policy in their image, or OpenShell's built-in default.</p>{{end}}
</div></section>
<p class="note">The order OpenShell picks a sandbox's policy in: a global policy on the gateway, then --policy at create, then /etc/openshell/policy.yaml in the image, then the built-in default.</p>
{{with $c.Policies}}<section class="panel gap-above"><div class="ph"><h2>Policy files</h2><span class="faint small">pass one with --policy at create</span></div><div class="pb">{{range .}}<div class="mono small">{{tilde .}}</div>{{end}}</div></section>{{end}}
<section class="panel tw gap-above"><table><thead><tr><th>Sandbox</th><th>Policy</th><th class="num">Version</th><th class="num">Provider rules</th></tr></thead><tbody>
{{range $g.Sandboxes}}<tr><td><a href="/sandboxes/{{$g.VM}}/{{.Name}}?tab=policy">{{.Name}}</a></td><td>{{with .Policy}}{{if .Err}}<span class="faint">{{.Err}}</span>{{else if .Global}}<span class="pill warn">global</span>{{else}}its own{{end}}{{else}}<span class="faint">–</span>{{end}}</td><td class="num mono">{{with .Policy}}{{.Version}}{{end}}</td><td class="num">{{with .Policy}}{{len .ProviderRules}}{{end}}</td></tr>
{{else}}<tr><td colspan="4" class="empty">No sandboxes.</td></tr>{{end}}
</tbody></table></section>
{{end}}

{{define "gateway-templates"}}{{$g := .Gateway}}
<section class="panel tw"><table><thead><tr><th>Template</th><th>Image</th><th>Resources</th><th>Sandboxes</th></tr></thead><tbody>
{{range $g.Templates}}{{$t := .}}<tr><td class="strong">{{.Name}}</td><td class="mono">{{.Image}}</td><td class="mono small">{{with .CPU}}{{.}} CPU{{end}}{{if and .CPU .Memory}} · {{end}}{{.Memory}}</td>
  <td>{{range $i, $s := templateSandboxes $g .Name}}{{if $i}}, {{end}}<a href="/sandboxes/{{$g.VM}}/{{$s}}">{{$s}}</a>{{else}}<span class="faint">–</span>{{end}}</td></tr>
{{else}}<tr><td colspan="4" class="empty">No sandbox templates. openshell sandbox template create makes one.</td></tr>{{end}}
</tbody></table></section>
<div class="stack gap-above">{{template "cmd" (cmd "The same list from your terminal" (oscmd $g.VM "sandbox" "template" "list"))}}</div>
{{end}}

{{/* A VM's sandboxes, its page's Sandboxes tab. */}}

{{define "vm-sandboxes"}}{{$v := .VM}}{{$g := gatewayOf .Snap $v.Name}}
{{template "gwnote" $g}}
<section class="panel tw"><table><thead><tr><th>Sandbox</th><th>State</th><th>Image</th><th>Providers</th></tr></thead><tbody>
{{range $g.Sandboxes}}<tr class="click" data-href="/sandboxes/{{$v.Name}}/{{.Name}}"><td><a class="rowlink" href="/sandboxes/{{$v.Name}}/{{.Name}}">{{.Name}}</a></td><td>{{template "phase" .Phase}}</td><td class="mono">{{.Image}}</td><td>{{template "chips" .Providers}}</td></tr>
{{else}}<tr><td colspan="4" class="empty">No sandboxes on {{$g.Name}}.</td></tr>{{end}}
</tbody></table></section>
<div class="actions gap-above">{{template "act" (act $ "sandbox-create" "" "primary" "vm" $v.Name)}}</div>
<p class="note"><a href="/gateways/{{$v.Name}}">{{$g.Name}}</a>: providers, profiles, policies and templates.</p>
{{end}}
