{{define "page-overview"}}
<div class="head"><div class="titles"><h1>Overview</h1>
  <div class="sub" sse-swap="overview-sub">{{template "overview-sub" .}}</div></div>
  <div class="actions">{{template "act" (act $ "create" "" "primary")}}</div>
</div>
<div class="grid g3 gap-below" sse-swap="vm-cards">{{template "vm-cards" .}}</div>
<div class="grid g2">
  <section class="panel" sse-swap="needs">{{template "needs" .}}</section>
  <section class="panel" sse-swap="recent-activity">{{template "recent-activity" .}}</section>
</div>
<section class="panel gap-above" sse-swap="recent-denials">{{template "recent-denials" .}}</section>
{{end}}
