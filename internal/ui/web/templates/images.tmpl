{{define "content"}}
<div class="head"><div class="titles"><h1>Images</h1><div class="sub"><span>{{term "base-image" "Base images"}} that VMs are made from. brig builds them with mkosi; {{term "sandbox-image" "sandbox images"}} come from your Podman.</span></div></div>
  <div class="actions">{{template "act" (act $ "image-push" "" "")}}{{template "act" (act $ "image-prune" "" "")}}{{template "act" (act $ "image-build" "" "primary")}}</div>
