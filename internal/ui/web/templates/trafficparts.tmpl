{{/* Traffic: the requests of sandboxes as OpenShell's proxy decided them
     (fence 1), from each gateway's log, and the rules OpenShell drafted
     from the denied ones. */}}

{{define "verdict"}}{{if eq . "deny"}}<span class="verdict deny">DENY</span>{{else if eq . "allow"}}<span class="verdict allow">ALLOW</span>{{else}}<span class="verdict">?</span>{{end}}{{end}}

{{/* A table of requests, newest first: .V is the view, .Rows the rows, and
     .Compact leaves out the sandbox. */}}

{{define "traffic-rows"}}{{$v := .V}}{{$c := .Compact}}
<table class="traffic"><thead><tr><th>Time</th><th>Verdict</th>{{if not $c}}<th>Sandbox</th>{{end}}<th>Program</th><th>Request</th><th>Rule or reason</th><th></th></tr></thead><tbody>
{{range .Rows}}{{if .Gap}}<tr class="gaprow"><td class="mono small">{{clock .Time}}</td><td colspan="{{if $c}}5{{else}}6{{end}}"><span class="faint">Requests of {{.Sandbox}} may be missing here.</span> {{.Gap}}</td></tr>
{{else if .Unparsed}}<tr><td class="mono small">{{clock .Time}}</td><td><span class="verdict" title="brig ui could not read this line; it is shown as it came">RAW</span></td>{{if not $c}}<td><a href="/sandboxes/{{.VM}}/{{.Sandbox}}?tab=traffic">{{.Sandbox}}</a> <span class="faint">{{.VM}}</span></td>{{end}}<td colspan="3" class="mono small raw">{{.Raw}}</td><td></td></tr>
{{else}}<tr><td class="mono small">{{clock .Time}}</td><td>{{template "verdict" .Verdict}}</td>{{if not $c}}<td><a href="/sandboxes/{{.VM}}/{{.Sandbox}}?tab=traffic">{{.Sandbox}}</a> <span class="faint">{{.VM}}</span></td>{{end}}
  <td class="mono small">{{with .Process}}{{.}}{{else}}<span class="faint">–</span>{{end}}</td>
  <td class="mono small req">{{.What}}</td>
  <td class="small">{{if .Denied}}{{with .Reason}}{{.}}{{else}}<span class="faint">no reason given</span>{{end}}{{else}}{{with .Policy}}<span class="mono">{{.}}</span>{{else}}<span class="faint">–</span>{{end}}{{with .Engine}} <span class="faint">{{.}}</span>{{end}}{{end}}</td>
  <td class="act">{{if .Denied}}{{if .Draft}}<span class="chip acc" title="OpenShell drafted the rule {{.Draft.Rule}} for this">draft</span> {{end}}{{template "act" (allowAct $v .)}}{{end}}</td></tr>
{{end}}{{else}}<tr><td colspan="{{if $c}}6{{else}}7{{end}}" class="empty">{{if $v.Snap.Traffic}}No requests here yet.{{else}}No traffic yet. brig ui follows the log of every sandbox on a running VM's gateway.{{end}}</td></tr>{{end}}
</tbody></table>
{{end}}

{{/* The Traffic page's table. */}}

{{define "traffic-table"}}{{$q := .TrafficQ}}
{{template "traffic-rows" (trafficTable . (trafficRows .) false)}}
{{$o := oldestShown .Snap $q}}{{if not $o.IsZero}}<div class="pb note">Since {{clock $o}}: older requests are no longer in the gateways' log buffers. The newest {{trafficShown}} show.</div>{{end}}
{{end}}

{{/* A sandbox's Traffic tab: its pending drafts, and its requests. */}}

{{define "sandbox-traffic"}}{{$g := .Gateway}}{{$s := .Sandbox}}
{{with sandboxDrafts .}}<section class="panel gap-below"><div class="ph"><h2>Rules OpenShell drafted</h2><span class="faint small">from the denied requests of {{$s.Name}}; approve one to add it to this sandbox</span></div>
<div class="tw"><table><thead><tr><th>Rule</th><th>Program</th><th>Endpoints</th><th class="num">Hits</th><th>Prover</th><th></th></tr></thead><tbody>
{{range .}}<tr><td class="mono">{{.Rule}}</td><td class="mono small">{{.Binary}}</td><td class="mono small">{{range $i, $e := .Endpoints}}{{if $i}}, {{end}}{{$e.Host}}:{{$e.Port}}{{end}}</td><td class="num">{{.Hits}}</td><td class="small">{{with .Validation}}{{.}}{{else}}<span class="faint">–</span>{{end}}</td><td class="act">{{template "act" (draftAct $ .)}}</td></tr>{{end}}
</tbody></table></div></section>{{end}}
<section class="panel tw">{{template "traffic-rows" (trafficTable . (sandboxTraffic .) true)}}</section>
<div class="stack gap-above">
  <p class="note"><a href="{{trafficURL $g.VM $s.Name true}}">Denied requests only</a> · Drops at fence 2, the VM's network profile, are not logged yet.</p>
  {{template "cmd" (cmd "The same log from your terminal" (oscmd $g.VM "logs" $s.Name "--tail" "--source" "sandbox"))}}
</div>
{{end}}

{{/* The Overview's recent denials. */}}

{{define "recent-denials"}}{{$rows := denialRows . 6}}
<div class="ph"><h2>Recent denials</h2><span class="grow"></span><a class="btn sm ghost" href="/traffic?verdict=deny">All traffic</a></div>
{{if $rows}}<div class="tw">{{template "traffic-rows" (trafficTable . $rows false)}}</div>{{else}}<div class="empty">No denied requests. Sandboxes that try to reach what their policy does not allow show here, with Allow….</div>{{end}}
{{end}}

{{/* Topology. */}}

{{define "topology"}}{{$t := topology . .Filter .Sel}}
<section class="panel"><div class="ph"><div class="legend"><span><i></i>configured</span><span><i class="hot"></i>provider of a running sandbox</span><span><i class="seen"></i>reached in the last hour</span><span><i class="deny"></i>denied in the last hour</span></div><span class="grow"></span><span class="faint small">Select a node to trace it</span></div>
<div class="pb topo"><svg viewBox="0 0 {{$t.Width}} {{$t.Height}}" width="{{$t.Width}}" height="{{$t.Height}}" role="img" aria-label="Topology from this host to the endpoints sandboxes reach">
<rect class="f1band" x="{{$t.FenceX}}" y="30" width="18" height="{{$t.FenceH}}" rx="3"/><text class="f1txt" x="{{$t.FenceTextX}}" y="{{$t.FenceTextY}}" text-anchor="middle">fence 1</text>
{{range $t.Heads}}<text class="col" x="{{.X}}" y="22">{{.Label}}</text>{{end}}
{{range $t.Edges}}<path class="e {{.Class}}{{if .Dim}} dim{{end}}" d="{{.D}}"/>{{end}}
{{range $t.Nodes}}<a href="{{.Link}}"><g class="n{{if .Sel}} sel{{end}}{{if .Dim}} dim{{end}}{{if .Off}} off{{end}}{{if .Bad}} bad{{end}}"><title>{{.Label}}</title><rect x="{{.X}}" y="{{.Y}}" width="{{.W}}" height="40" rx="6"/><circle class="sdot" cx="{{.DotX}}" cy="{{.DotY}}" r="3.5"/><text x="{{.TextX}}" y="{{.LabelY}}">{{.Label}}</text><text class="s" x="{{.TextX}}" y="{{.SubY}}">{{.Sub}}</text></g></a>{{end}}
</svg></div>
{{with $t.More}}<div class="pb note">{{.}} more endpoints left out.</div>{{end}}
{{with $t.Sel}}<div class="pb trace">{{template "topo-detail" (topoDetailView $ .)}}</div>{{end}}
</section>
{{end}}

{{define "topo-detail"}}{{$v := .V}}{{$d := .D}}
{{if eq $d.Kind "host"}}<b>{{$d.Node.Label}}</b> runs brig, brig ui and the openshell CLI, which reach each VM's gateway over mTLS on 127.0.0.1.
{{else if eq $d.Kind "gw"}}<b>{{$d.Gateway.Name}}</b> is {{$d.Gateway.State}}{{with $d.Gateway.Version}}, OpenShell {{.}}{{end}}. <a href="/vms/{{$d.VM}}">Open the VM</a> · <a href="/gateways/{{$d.VM}}">Open the gateway</a> · <a href="{{trafficURL $d.VM "" false}}">See its traffic</a>
{{else if eq $d.Kind "sb"}}<b>{{$d.Name}}</b> on {{$d.VM}} is {{$d.Sandbox.Phase}}. <a href="/sandboxes/{{$d.VM}}/{{$d.Name}}">Open the sandbox</a> · <a href="/sandboxes/{{$d.VM}}/{{$d.Name}}?tab=traffic">See its traffic</a>
{{else if eq $d.Kind "pr"}}<b>Provider {{$d.Name}}</b>{{with $d.Profile}} sends {{range $i, $c := .Credentials}}{{if $i}}, {{end}}{{range $j, $e := $c.EnvVars}}{{if $j}}, {{end}}{{$e}}{{end}}{{end}} only to {{range $i, $e := .Endpoints}}{{if $i}}, {{end}}{{$e}}{{end}}{{with .Binaries}}, only from {{range $i, $b := .}}{{if $i}}, {{end}}{{$b}}{{end}}{{end}}.{{else}} has a profile that {{$d.Gateway.Name}} does not list.{{end}} <a href="/gateways/{{$d.VM}}">Open the gateway</a>
{{else if eq $d.Kind "ep"}}{{with $d.Denial}}<b>{{$d.Name}}</b> was denied for <a href="/sandboxes/{{.VM}}/{{.Sandbox}}?tab=traffic">{{.Sandbox}}</a>{{with .Reason}}: {{.}}{{end}}. {{template "act" (allowAct $v .)}}{{else}}<b>{{$d.Name}}</b>{{if $d.Allowed}} was reached {{$d.Allowed}} time{{if ne $d.Allowed 1}}s{{end}} in the last hour{{else}} was not reached in the last hour{{end}}{{with $d.Providers}}; the credentials of {{range $i, $p := .}}{{if $i}}, {{end}}{{$p}}{{end}} go there{{end}}.{{end}}
{{end}}
{{end}}
