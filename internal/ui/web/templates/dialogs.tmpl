{{/*
  Dialogs. "dialog" is the frame around the fields of an action, which "dlg-ID"
  holds. The frame asks /a/ID/preview for the command as the form changes, and
  runs it with /a/ID/run. A dialog shows the command it runs; it never sends one.
*/}}

{{define "dialog"}}
<div class="scrim" id="dialog" data-dialog>
<form class="modal" autocomplete="off" role="dialog" aria-label="{{.Heading}}" hx-post="/a/{{.ID}}/run" hx-target="#tasks" hx-swap="innerHTML">
  <div class="mh"><h2>{{.Heading}}</h2>{{with .Lead}}<div class="muted">{{.}}</div>{{end}}</div>
  <div class="mb">
    {{.Body}}
    {{with .Typed}}<div class="field"><label for="d-confirm">Type <b class="mono">{{.}}</b> to confirm</label><input type="text" id="d-confirm" name="confirm" autocomplete="off" spellcheck="false"></div>{{end}}
    <div id="preview" class="stack" hx-post="/a/{{.ID}}/preview" hx-target="this" hx-trigger="load, input from:closest form delay:150ms, change from:closest form" hx-swap="innerHTML"></div>
  </div>
  <div class="mf"><button type="button" class="btn" data-dialog-close>Cancel</button><button type="submit" class="btn {{if .Spec.Danger}}danger{{else}}primary{{end}}" id="dialog-ok" disabled>{{.Spec.OK}}</button></div>
</form>
</div>
{{end}}

{{define "vmfield"}}<input type="hidden" name="vm" value="{{.Form.Get "vm"}}">{{end}}

{{define "dlg-start"}}{{template "vmfield" .}}
<p class="muted">Boots {{.Form.Get "vm"}}, waits for its OpenShell gateway, registers the gateway with your openshell CLI as <span class="mono">brig-{{.Form.Get "vm"}}</span> and applies the VM's config directories.</p>
{{end}}

{{define "dlg-stop"}}{{template "vmfield" .}}
<p class="muted">Asks the guest to shut down. Sandboxes in {{.Form.Get "vm"}} stop with it; their workspaces stay on the data disk.</p>
<div class="checks"><label><input type="checkbox" name="force"{{if .Form.Get "force"}} checked{{end}}> Power off at once <small>Does not wait for the guest. Unsaved work in the VM can be lost.</small></label></div>
{{end}}

{{define "dlg-delete"}}{{template "vmfield" .}}
<div class="callout bad">This deletes the data disk too: every sandbox workspace, the providers' secrets in the gateway and pushed images. Push agent branches first.</div>
{{end}}

{{define "dlg-upgrade"}}{{template "vmfield" .}}
<div class="callout">The data disk stays, with every provider, template, image and workspace. The root disk is replaced by a fresh one on the new base image. brig starts the VM once to check it, and rolls back if the gateway does not answer.</div>
{{end}}

{{define "dlg-mount-add"}}{{template "vmfield" .}}
<div class="row">
  <div class="field"><label for="m-src">Host directory</label><input type="text" id="m-src" name="src" value="{{.Form.Get "src"}}" placeholder="~/src/notes" autocapitalize="off" spellcheck="false"></div>
  <div class="field"><label for="m-target">In the VM</label><input type="text" id="m-target" name="target" value="{{.Form.Get "target"}}" placeholder="/mnt/notes" autocapitalize="off" spellcheck="false"><span class="hint">Default: /mnt/ and the directory's name.</span></div>
</div>
<div class="field"><span class="lbl">Access</span><div class="checks">
  <label><input type="radio" name="access" value="ro"{{if ne (.Form.Get "access") "rw"}} checked{{end}}> Read-only <small>The default.</small></label>
  <label><input type="radio" name="access" value="rw"{{if eq (.Form.Get "access") "rw"}} checked{{end}}> Read-write <small>What the agent user writes in the VM is yours on the host.</small></label></div></div>
<div class="checks"><label><input type="checkbox" name="sandbox"{{if .Form.Get "sandbox"}} checked{{end}}> Offer to sandboxes <small>Sandboxes can attach it as a read-only Podman volume. This replaces read-write.</small></label></div>
{{end}}

{{define "dlg-mount-rm"}}{{template "vmfield" .}}<input type="hidden" name="target" value="{{.Form.Get "target"}}">
{{$t := .Form.Get "target"}}
<p class="muted">Stops sharing {{range .VM.Mounts}}{{if eq .Target $t}}<span class="mono">{{tilde .Source}}</span> {{end}}{{end}}at <span class="mono">{{$t}}</span>. The directory on the host stays as it is.</p>
{{end}}

{{define "dlg-profile"}}{{template "vmfield" .}}
<div class="field"><label for="n-profile">Profile</label><select id="n-profile" name="profile">{{range profileNames .Snap}}<option value="{{.}}"{{if eq . ($.Form.Get "profile")}} selected{{end}}>{{.}}</option>{{end}}</select>
  <span class="hint">Profiles live in config.yaml. This is fence 2: it applies to every sandbox in the VM, from outside the VM.</span></div>
{{end}}

{{define "dlg-resources"}}{{template "vmfield" .}}
<div class="row">
  <div class="field"><label for="z-cpus">CPUs</label><input type="text" id="z-cpus" name="cpus" value="{{.Form.Get "cpus"}}" inputmode="numeric"></div>
  <div class="field"><label for="z-memory">Memory</label><input type="text" id="z-memory" name="memory" value="{{.Form.Get "memory"}}" placeholder="16GiB"></div>
</div>
<div class="row">
  <div class="field"><label for="z-root">Root disk</label><input type="text" id="z-root" name="root-disk" value="{{.Form.Get "root-disk"}}" placeholder="30GiB"></div>
  <div class="field"><label for="z-data">Data disk</label><input type="text" id="z-data" name="data-disk" value="{{.Form.Get "data-disk"}}" placeholder="80GiB"></div>
</div>
<p class="note">Disks only grow. The guest grows its file systems at the next boot.</p>
{{end}}

{{define "dlg-config-add"}}{{template "vmfield" .}}
<div class="field"><label for="c-dir">Directory</label><input type="text" id="c-dir" name="dir" value="{{.Form.Get "dir"}}" placeholder="~/src/agent-openshell" autocapitalize="off" spellcheck="false"><span class="hint">With profiles/*.yaml, providers/*.yaml and policies/default.yaml. Secrets stay in your keyring.</span></div>
{{end}}

{{define "dlg-config-rm"}}{{template "vmfield" .}}<input type="hidden" name="dir" value="{{.Form.Get "dir"}}">
<p class="muted">Stops applying <span class="mono">{{tilde (.Form.Get "dir")}}</span> to {{.Form.Get "vm"}}. The directory itself stays.</p>
{{end}}

{{define "dlg-create"}}
<div class="row">
  <div class="field"><label for="v-name">Name</label><input type="text" id="v-name" name="name" value="{{.Form.Get "name"}}" placeholder="scratch" autocapitalize="off" spellcheck="false"><span class="hint">Lowercase letters, digits and dashes.</span></div>
  <div class="field"><label for="v-profile">Network</label><select id="v-profile" name="profile">{{range profileNames .Snap}}<option value="{{.}}"{{if eq . ($.Form.Get "profile")}} selected{{end}}>{{.}}</option>{{end}}</select></div>
</div>
<div class="row">
  <div class="field"><label for="v-cpus">CPUs</label><input type="text" id="v-cpus" name="cpus" value="{{.Form.Get "cpus"}}" inputmode="numeric"></div>
  <div class="field"><label for="v-memory">Memory</label><input type="text" id="v-memory" name="memory" value="{{.Form.Get "memory"}}" placeholder="8GiB"></div>
</div>
<div class="checks">
  {{if .Snap.Config.OpenShellConfigs}}<label><input type="checkbox" name="configs"{{if .Form.Get "configs"}} checked{{end}}> Apply the config directories from config.yaml <small>{{range .Snap.Config.OpenShellConfigs}}<span class="mono">{{tilde .}}</span> {{end}}</small></label>{{end}}
  <label><input type="checkbox" name="start"{{if .Form.Get "start"}} checked{{end}}> Start it after creating</label>
</div>
<p class="note">Add host directories on the VM's Mounts tab once it exists.</p>
{{end}}

{{define "dlg-sync-preview"}}{{template "vmfield" .}}
{{with .Gateway.Config.WorkspaceNames}}{{if gt (len .) 1}}<div class="field"><label for="y-ws">Workspace</label><select id="y-ws" name="workspace"><option value="">All of them</option>{{range .}}<option value="{{.}}"{{if eq . ($.Form.Get "workspace")}} selected{{end}}>{{.}}</option>{{end}}</select></div>{{end}}{{end}}
<p class="muted">Compares the config directories of {{.Form.Get "vm"}} with its gateway and reports what a sync would create, update or leave. Nothing changes. The report shows in the task card; Sync is one press away.</p>
{{end}}

{{define "dlg-sync"}}{{template "vmfield" .}}
{{with .Gateway.Config.WorkspaceNames}}{{if gt (len .) 1}}<div class="field"><label for="y-ws">Workspace</label><select id="y-ws" name="workspace"><option value="">All of them</option>{{range .}}<option value="{{.}}"{{if eq . ($.Form.Get "workspace")}} selected{{end}}>{{.}}</option>{{end}}</select></div>{{end}}{{end}}
<p class="muted">Applies the config directories of {{.Form.Get "vm"}} to its gateway: profiles, providers and the default policy. A provider's secrets may be sent to the endpoints of its profile; preview first if a profile changed.</p>
<div class="checks">
  <label><input type="checkbox" name="refresh"{{if .Form.Get "refresh"}} checked{{end}}> Refresh every provider's credentials <small>Even those that did not change in the keyring.</small></label>
  <label><input type="checkbox" name="prune"{{if .Form.Get "prune"}} checked{{end}}> Prune <small>Deletes profiles and providers that brig created but no directory defines any more.</small></label>
</div>
{{end}}

{{define "dlg-image-build"}}
<div class="row">
  <div class="field"><label for="b-fedora">Fedora</label><input type="text" id="b-fedora" name="fedora" value="{{.Form.Get "fedora"}}" inputmode="numeric"></div>
  <div class="field"><label for="b-openshell">OpenShell</label><input type="text" id="b-openshell" name="openshell" value="{{.Form.Get "openshell"}}" placeholder="newest in the repository" autocapitalize="off" spellcheck="false"><span class="hint">A version such as 0.1.2.</span></div>
</div>
{{end}}

{{define "dlg-image-prune"}}
<p class="muted">Removes base images that no VM uses, except the newest, and mkosi's package cache.</p>
{{end}}

{{define "dlg-image-push"}}
{{if runningVMs .Snap}}
<div class="row">
  <div class="field"><label for="p-vm">VM</label><select id="p-vm" name="vm">{{range runningVMs .Snap}}<option value="{{.Name}}"{{if eq .Name ($.Form.Get "vm")}} selected{{end}}>{{.Name}}</option>{{end}}</select></div>
  <div class="field"><label for="p-image">Image in your Podman</label><input type="text" id="p-image" name="image" value="{{.Form.Get "image"}}" placeholder="localhost/my-agent:latest" autocapitalize="off" spellcheck="false"><span class="hint">As podman images lists it.</span></div>
</div>
{{else}}<div class="callout warn">No VM is running. Start one first: the image is loaded into its Podman.</div><input type="hidden" name="vm" value="">{{end}}
{{end}}

{{/* Sandboxes. A sandbox dialog names the VM and the sandbox in hidden fields. */}}

{{define "sbfields"}}<input type="hidden" name="vm" value="{{.Form.Get "vm"}}"><input type="hidden" name="workspace" value="{{.Form.Get "workspace"}}"><input type="hidden" name="sandbox" value="{{.Form.Get "sandbox"}}">{{end}}

{{define "dlg-sandbox-create"}}{{$g := .Gateway}}
{{if not (readyGateways .Snap)}}<div class="callout warn">No VM has a reachable OpenShell gateway. Start a VM first.</div><input type="hidden" name="vm" value="">
{{else}}
<div class="row">
  <div class="field"><label for="s-vm">VM</label>{{if gt (len (readyGateways .Snap)) 1}}<select id="s-vm" name="vm" hx-get="/a/sandbox-create" hx-trigger="change" hx-target="#layer" hx-swap="innerHTML">{{range readyGateways .Snap}}<option value="{{.VM}}"{{if eq .VM ($.Form.Get "vm")}} selected{{end}}>{{.VM}}</option>{{end}}</select><span class="hint">Changing it starts the form over.</span>
  {{else}}<input type="text" id="s-vm" value="{{$g.VM}}" disabled><input type="hidden" name="vm" value="{{$g.VM}}">{{end}}</div>
  {{if $g.MultiWorkspace}}<div class="field"><label for="s-ws">Workspace</label><select id="s-ws" name="workspace" hx-get="/a/sandbox-create" hx-trigger="change" hx-include="[name=vm]" hx-target="#layer" hx-swap="innerHTML">{{range $g.Workspaces}}<option value="{{.}}"{{if eq . ($.Form.Get "workspace")}} selected{{end}}>{{.}}</option>{{end}}</select><span class="hint">Providers and templates are per workspace; changing it starts the form over.</span></div>
  {{else}}<input type="hidden" name="workspace" value="{{.Form.Get "workspace"}}">{{end}}
  <div class="field"><label for="s-name">Name</label><input type="text" id="s-name" name="name" value="{{.Form.Get "name"}}" placeholder="webapp" autocapitalize="off" spellcheck="false"><span class="hint">Letters, digits, dots, dashes and underscores.</span></div>
</div>
<div class="row">
  <div class="field"><label for="s-template">Template</label><select id="s-template" name="template"><option value="">none</option>{{range templatesIn $g (.Form.Get "workspace")}}<option value="{{.Name}}"{{if eq .Name ($.Form.Get "template")}} selected{{end}}>{{.Name}} · {{.Image}}</option>{{end}}</select></div>
  <div class="field"><label for="s-image">or image</label><input type="text" id="s-image" name="image" value="{{.Form.Get "image"}}" placeholder="localhost/pi-agent:2026-10-08" autocapitalize="off" spellcheck="false"><span class="hint">As podman images lists it in {{$g.VM}}. A template brings its own.</span></div>
</div>
<div class="field"><span class="lbl">Providers</span><div class="checks">
  {{range providersIn $g (.Form.Get "workspace")}}{{$p := .}}<label><input type="checkbox" name="provider" value="{{.Name}}"{{if formHas $.Form "provider" .Name}} checked{{end}}> {{.Name}} <small>{{with profileOf $g .Workspace .Type}}opens {{range $i, $e := .Endpoints}}{{if $i}}, {{end}}{{$e}}{{else}}no endpoint{{end}}{{end}}</small></label>
  {{else}}<span class="faint small">None on {{$g.Name}}. Define them in a config directory and sync.</span>{{end}}</div></div>
<div class="field"><label for="s-policy">Policy</label><select id="s-policy" name="policy"><option value="">{{if $g.Config.DefaultPolicy}}default · {{tilde $g.Config.DefaultPolicy}}{{else}}the image's, else OpenShell's{{end}}</option>{{range $g.Config.Policies}}<option value="{{.}}"{{if eq . ($.Form.Get "policy")}} selected{{end}}>{{tilde .}}</option>{{end}}</select>
  <span class="hint">The providers add their own network rules to it.</span></div>
<div class="field"><label for="s-mounts">Host directories</label><textarea id="s-mounts" name="mounts" rows="2" placeholder="~/src/pi-kit:/usr/local/share/pi-kit" autocapitalize="off" spellcheck="false">{{.Form.Get "mounts"}}</textarea>
  <span class="hint">One DIR:TARGET per line. The sandbox sees DIR read-only at TARGET.</span></div>
{{end}}
{{end}}

{{define "dlg-sandbox-start"}}{{template "sbfields" .}}
<p class="muted">Starts {{.Form.Get "sandbox"}} on {{.Gateway.Name}} again with the workspace it had. Programs that ran in it, your agent included, are not restarted.</p>
{{end}}

{{define "dlg-sandbox-stop"}}{{template "sbfields" .}}
<p class="muted">Stops {{.Form.Get "sandbox"}}, and every program in it. The workspace /sandbox, its providers and policy stay; start it again later.</p>
{{end}}

{{define "dlg-sandbox-delete"}}{{template "sbfields" .}}
<div class="callout bad">This deletes the workspace /sandbox of {{.Form.Get "sandbox"}}: checkouts, agent settings and sessions. Providers, templates and images stay. Push branches and copy sessions out first.</div>
{{end}}

{{define "dlg-sandbox-attach"}}{{template "sbfields" .}}{{$g := .Gateway}}
{{with unattached $g .Sandbox}}
<div class="field"><label for="a-provider">Provider</label><select id="a-provider" name="provider">{{range .}}<option value="{{.Name}}"{{if eq .Name ($.Form.Get "provider")}} selected{{end}}>{{.Name}}{{with .Type}} · {{.}}{{end}}</option>{{end}}</select>
  <span class="hint">Its credentials stay in the gateway; the sandbox sees placeholders.</span></div>
{{else}}<div class="callout warn">Every provider of {{$g.Name}} is attached already.</div><input type="hidden" name="provider" value="">{{end}}
{{end}}

{{define "dlg-sandbox-detach"}}{{template "sbfields" .}}<input type="hidden" name="provider" value="{{.Form.Get "provider"}}">
<p class="muted">{{.Form.Get "sandbox"}} loses {{.Form.Get "provider"}}: the network rules it added, and the placeholders of new programs. A program that runs already keeps what it has until it restarts.</p>
{{end}}

{{/* The commands to run in your own terminal: a terminal in the browser is deferred, and nothing here runs. */}}

{{define "terminal"}}{{$g := .Gateway}}{{$s := .Sandbox}}
<div class="scrim" id="dialog" data-dialog>
<div class="modal" role="dialog" aria-label="Connect to {{$s.Name}}">
  <div class="mh"><h2>Connect to {{$s.Name}} <span class="muted">· workspace {{$s.Workspace}}</span></h2><div class="muted">Run these in your own terminal. brig ui shows no terminal of its own.</div></div>
  <div class="mb">
    {{if not $s.Ready}}<div class="callout warn">{{$s.Name}} is {{lower $s.Phase}}. {{if eq $s.Phase "Stopped"}}Start it first.{{else}}These work once it runs.{{end}}</div>{{end}}
    {{template "cmd" (cmd "Attach to the sandbox's shell. Ctrl-P, Ctrl-Q leaves it running." (oscmd $g.VM $s.Workspace "sandbox" "connect" $s.Name))}}
    {{template "cmd" (cmd "A second shell, in the same sandbox" (oscmd $g.VM $s.Workspace "sandbox" "exec" "-n" $s.Name "--tty" "--" "bash" "-l"))}}
    <p class="note">The commands name the gateway {{$g.Name}}, so they work whichever gateway your shell points at. They use your host's ssh, which reads ~/.ssh/config.</p>
  </div>
  <div class="mf"><button type="button" class="btn" data-dialog-close>Close</button></div>
</div>
</div>
{{end}}

{{/* Allow…: approve the rule that OpenShell drafted, or add one. The mode
     radio shows one of the two sets of fields; the server builds only the
     command of the mode chosen. */}}

{{define "dlg-allow"}}{{template "sbfields" .}}{{with .Form.Get "req"}}<input type="hidden" name="req" value="{{.}}">{{end}}
{{$r := .Request}}{{$d := .Draft}}{{$sb := .Form.Get "sandbox"}}
{{if $d}}<div class="field"><span class="lbl">Rule</span><div class="checks">
  <label><input type="radio" name="mode" value="draft"{{if eq (.Form.Get "mode") "draft"}} checked{{end}}> Approve OpenShell's draft <small>The rule OpenShell drafted from the denials, with the program's full path.</small></label>
  <label><input type="radio" name="mode" value="rule"{{if eq (.Form.Get "mode") "rule"}} checked{{end}}> A rule of your own <small>Choose the access level and whether to enforce or audit.</small></label></div></div>
<input type="hidden" name="draft" value="{{$d.ID}}">
<div class="mode-draft stack">
  <pre class="code">{{$d.YAML}}</pre>
  <dl class="kv">
    {{with $d.Rationale}}<dt>Why</dt><dd>{{.}}</dd>{{end}}
    <dt>Prover</dt><dd>{{with $d.Validation}}{{.}}{{else}}<span class="faint">no verdict</span>{{end}}</dd>
    <dt>Seen</dt><dd>{{$d.Hits}} time{{if ne $d.Hits 1}}s{{end}}{{if not $d.LastSeen.IsZero}}, last {{rel $d.LastSeen}}{{end}}</dd>
  </dl>
</div>
{{else}}<input type="hidden" name="mode" value="rule">{{end}}
<div class="mode-rule stack">
<div class="row">
  <div class="field"><label for="a-host">Host</label><input type="text" id="a-host" name="host" value="{{.Form.Get "host"}}" placeholder="registry.npmjs.org" autocapitalize="off" spellcheck="false"></div>
  <div class="field"><label for="a-port">Port</label><input type="text" id="a-port" name="port" value="{{.Form.Get "port"}}" placeholder="443" inputmode="numeric"></div>
</div>
<div class="row">
  <div class="field"><label for="a-binary">Program</label><input type="text" id="a-binary" name="binary" value="{{.Form.Get "binary"}}" placeholder="/usr/bin/node" autocapitalize="off" spellcheck="false">
    <span class="hint">{{if and $r $r.NameOnly}}The log named only {{$r.Process}}, so this path is a guess. Check it with <span class="mono">{{.PathCheck}}</span>{{else}}Its full path in the sandbox.{{end}}</span></div>
  <div class="field"><label for="a-rule">Rule name</label><input type="text" id="a-rule" name="rule" value="{{.Form.Get "rule"}}" placeholder="allow_HOST_PORT" autocapitalize="off" spellcheck="false"><span class="hint">An existing rule of that name gets the endpoint added.</span></div>
</div>
<div class="row">
  <div class="field"><label for="a-protocol">Inspect</label><select id="a-protocol" name="protocol">
    <option value="rest"{{if eq (.Form.Get "protocol") "rest"}} selected{{end}}>HTTP requests (rest)</option>
    <option value=""{{if eq (.Form.Get "protocol") ""}} selected{{end}}>The whole connection</option></select></div>
  <div class="field rest-only"><label for="a-access">Access</label><select id="a-access" name="access">
    <option value="read-only"{{if eq (.Form.Get "access") "read-only"}} selected{{end}}>read-only: GET, HEAD, OPTIONS</option>
    <option value="read-write"{{if eq (.Form.Get "access") "read-write"}} selected{{end}}>read-write: also POST, PUT, PATCH</option>
    <option value="full"{{if eq (.Form.Get "access") "full"}} selected{{end}}>full: every method</option></select></div>
</div>
<div class="field rest-only"><span class="lbl">Mode</span><div class="checks">
  <label><input type="radio" name="enforcement" value="enforce"{{if ne (.Form.Get "enforcement") "audit"}} checked{{end}}> Enforce <small>Allow what the access level allows, deny the rest.</small></label>
  <label><input type="radio" name="enforcement" value="audit"{{if eq (.Form.Get "enforcement") "audit"}} checked{{end}}> Audit <small>Log what it would deny and let it pass, to learn what the agent needs.</small></label></div></div>
</div>
{{if and $r $r.CredentialMismatch}}<div class="callout warn">The provider's credential is not bound to {{$r.Host}}. A rule lets the request go out without the real credential. To send the credential, add the host to the endpoints of the provider's profile instead (<a href="/gateways/{{.Form.Get "vm"}}?tab=profiles">profiles</a>).</div>
<div class="checks"><label><input type="checkbox" name="anyway"{{if .Form.Get "anyway"}} checked{{end}}> Allow anyway <small>Without the credential.</small></label></div>{{end}}
<p class="note">Applies to {{$sb}} in workspace {{.Form.Get "workspace"}} only, at once. To keep the rule for new sandboxes, save it to the policy file next.</p>
{{end}}

{{/* Save to file…: brig policy save, previewed first. */}}

{{define "savefields"}}
<div class="row">
  <div class="field"><label for="s-rule">Rule</label><input type="text" id="s-rule" name="rule" value="{{.Form.Get "rule"}}" placeholder="every unsaved rule" autocapitalize="off" spellcheck="false"><span class="hint">Its key under network_policies. A rule the file has too is saved only when named here.</span></div>
  <div class="field"><label for="s-to">File</label><input type="text" id="s-to" name="to" value="{{.Form.Get "to"}}" placeholder="the sandbox's policy file" autocapitalize="off" spellcheck="false"><span class="hint">A name such as {{.Form.Get "sandbox"}} creates policies/{{.Form.Get "sandbox"}}.yaml; or a path. Needed when the sandbox came from policies/default.yaml.</span></div>
</div>
{{end}}

{{define "dlg-policy-save-preview"}}{{template "sbfields" .}}
<p class="muted">Shows the change that saving the rules added to {{.Form.Get "sandbox"}}, such as with Allow…, makes to its policy file, so that sandboxes created from the file get them too. Nothing changes; Save is one press away.</p>
{{template "savefields" .}}
{{end}}

{{define "dlg-policy-save"}}{{template "sbfields" .}}
<p class="muted">Writes the rules added to {{.Form.Get "sandbox"}} into its policy file. The file is not applied to other sandboxes, nor committed.</p>
{{template "savefields" .}}
{{end}}
