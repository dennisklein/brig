[brig]
name=brig - Fedora $releasever - $basearch
baseurl=https://dennisklein.github.io/brig/rpm/fedora/$releasever/$basearch/
enabled=1
gpgcheck=1
repo_gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-brig
metadata_expire=6h

[brig-source]
name=brig - Fedora - Source
baseurl=https://dennisklein.github.io/brig/rpm/fedora/source/
enabled=0
gpgcheck=1
repo_gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-brig
metadata_expire=6h
